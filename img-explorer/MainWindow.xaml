<Window x:Class="ImgExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="img-explorer"
        Width="1100"
        Height="760"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        PreviewKeyDown="OnPreviewKeyDown">

    <DockPanel>

        <!-- Панель инструментов -->
        <Border DockPanel.Dock="Top" Background="#FF262626" Padding="10,7">
            <DockPanel>
                <Button x:Name="OpenButton"
                        DockPanel.Dock="Left"
                        Content="Открыть… (W)"
                        Padding="14,5"
                        Click="OnOpenClick" />
                <TextBlock x:Name="FileNameText"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFD6D6D6"
                           TextTrimming="CharacterEllipsis"
                           Text="Нет изображения" />
            </DockPanel>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="#FF262626" Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF8A8A8A"
                           Text="Q — точка · W — открыть · Esc — сбросить" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#FFCFCFCF"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Рабочая область: изображение в масштабе 1:1 без масштабирования -->
        <Grid>
            <ScrollViewer x:Name="Scroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#FF1B1B1B">
                <Grid x:Name="ImageHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      MouseMove="OnImageHostMouseMove"
                      MouseLeave="OnImageHostMouseLeave">
                    <Image x:Name="ImageView"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="Overlay"
                            IsHitTestVisible="False"
                            ClipToBounds="True" />
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="Placeholder"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="16"
                       Foreground="#FF7A7A7A"
                       Text="Нажмите «Открыть…» или W&#10;png · jpg · webp · gif" />
        </Grid>

    </DockPanel>
</Window>
