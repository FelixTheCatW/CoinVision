<Window x:Class="BoxesExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="boxes-explorer"
        Width="1600"
        Height="900"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1B"
        Foreground="#FFD6D6D6"
        FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF262626" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8A8A8A" />

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2C2C2C" />
            <Setter Property="Foreground" Value="#FFBDBDBD" />
            <Setter Property="BorderBrush" Value="#FF3A3A3A" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFE2E2E2" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFE2E2E2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Панель инструментов -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="10,7">
            <DockPanel>
                <Button x:Name="SaveButton"
                        DockPanel.Dock="Right"
                        Content="Сохранить (Ctrl+S)"
                        Padding="14,4"
                        Click="OnSaveClick" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="#FF6F6F6F"
                           Text="Q — точка · 1/2 — engraved/slab · ↑↓ — строка"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FilledText"
                           DockPanel.Dock="Right"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="FileText"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="#FFD6D6D6"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="SaveStateText"
                           DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#FFCFCFCF"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="760" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Изображение выбранной строки: масштаб 1:1, поверх — маска области -->
            <Grid Grid.Column="0">
                <ScrollViewer x:Name="Scroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#FF1B1B1B">
                    <Grid x:Name="ImageHost"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          MouseMove="OnImageHostMouseMove"
                          MouseLeave="OnImageHostMouseLeave">
                        <Image x:Name="ImageView"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Canvas x:Name="Overlay"
                                IsHitTestVisible="False"
                                ClipToBounds="True" />
                    </Grid>
                </ScrollViewer>

                <TextBlock x:Name="Placeholder"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsHitTestVisible="False"
                           FontSize="15"
                           Foreground="#FF7A7A7A"
                           TextWrapping="Wrap"
                           MaxWidth="440"
                           Text="Выберите строку в таблице —&#10;изображение откроется здесь в масштабе 1:1" />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FF2E2E2E"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <!-- Таблица date_boxes.csv -->
            <DataGrid x:Name="Table"
                      Grid.Column="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FF2E2E2E"
                      Background="#FF1F1F1F"
                      Foreground="#FFDEDEDE"
                      BorderThickness="0"
                      RowHeight="23"
                      SelectionChanged="OnSelectionChanged"
                      BeginningEdit="OnBeginningEdit"
                      CellEditEnding="OnCellEditEnding">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FFDEDEDE" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF272727" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF2F4A6B" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="image"
                                        Binding="{Binding Image}"
                                        IsReadOnly="True"
                                        Width="340">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Image}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="box (x1,y1 … x4,y4)"
                                        Binding="{Binding Box}"
                                        IsReadOnly="True"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Box}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="kind" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Kind}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          ItemsSource="{Binding KindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="year"
                                        Binding="{Binding Year}"
                                        IsReadOnly="True"
                                        Width="64" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
