{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.Extensions.Hosting": "Warning"
      }
    }
  },
  "Model": {
    "Directory": "../../onnx",
    "MaxModels": 8
  },
  "Uploads": {
    "MaxFilesPerRequest": 50,
    "MaxFileBytes": 26214400
  },
  "AllowedHosts": "*"
}
